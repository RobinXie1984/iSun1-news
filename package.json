{
  "name": "isun1-story-engine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "export": "node scripts/export.mjs",
    "discover": "python3 scripts/discover.py",
